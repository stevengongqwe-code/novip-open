{
  "name": "handwrite-studio",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "node scripts/prepare-ocr.mjs && node scripts/prepare-pdfjs.mjs && node scripts/prepare-reports.mjs && node scripts/add-handwriting-fonts.mjs && tsc -b && vite build && node --import tsx scripts/generate-seo.mjs",
    "verify:seo": "node --import tsx scripts/verify-seo-build.mjs dist",
    "security:scan": "gitleaks detect --config .gitleaks.toml --redact --no-git",
    "security:audit": "npm audit --audit-level=high",
    "security:pre-commit": "node scripts/security-pre-commit.mjs",
    "test": "node --import tsx --test tests/*.test.ts",
    "preview": "vite preview --host 0.0.0.0",
    "test:conversion": "node --import tsx tests/run-conversion.mjs",
    "test:conversion:browser": "node tests/conversion-browser.mjs",
    "test:study": "node tests/study-integration.mjs && node tests/study-ui.mjs",
    "typecheck": "tsc -b",
    "lint": "eslint src tests/*.test.ts",
    "test:analytics": "node --experimental-strip-types --test tests/analytics.test.mjs",
    "verify:immersive": "node scripts/verify-immersive-novip.mjs"
  },
  "dependencies": {
    "@breezystack/lamejs": "^1.2.7",
    "@chromeos/android-package-signer": "^0.1.3",
    "@pdfme/common": "^6.2.8",
    "@pdfme/generator": "^6.2.8",
    "@pdfme/schemas": "^6.2.8",
    "@xmldom/xmldom": "^0.8.11",
    "animejs": "^4.5.0",
    "docx": "^9.5.1",
    "fflate": "^0.8.2",
    "gifenc": "^1.0.3",
    "jspdf": "^4.2.1",
    "jsqr": "^1.4.0",
    "lucide-react": "^0.468.0",
    "mermaid": "^12.2.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.2.108",
    "pptxgenjs": "^4.0.1",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tesseract.js": "^6.0.1",
    "xlsx": "file:vendor/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@chinese-fonts/xiaolai": "^3.0.0",
    "@chinese-fonts/yozai": "^3.0.0",
    "@fontsource/klee-one": "^5.3.1",
    "@fontsource/liu-jian-mao-cao": "^5.3.0",
    "@fontsource/long-cang": "5.3.0",
    "@fontsource/lxgw-wenkai": "5.3.0",
    "@fontsource/ma-shan-zheng": "5.3.1",
    "@fontsource/noto-sans-sc": "^5.3.1",
    "@fontsource/zcool-kuaile": "^5.3.0",
    "@fontsource/zhi-mang-xing": "^5.3.0",
    "@tesseract.js-data/chi_sim": "^1.0.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "@types/node": "^22.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "eslint": "^10.14.0",
    "jsdom": "^30.1.2",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.72.1",
    "vite": "^6.3.0"
  },
  "overrides": {
    "image-size": "^2.0.3"
  }
}
