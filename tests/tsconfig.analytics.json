{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": [
      "react"
    ]
  },
  "include": [
    "../src/analytics/**/*.ts",
    "../src/analytics/**/*.tsx",
    "../src/tools/registry.ts",
    "./analytics-css.d.ts"
  ]
}
